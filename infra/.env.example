# Copy to .env and fill.
# Generate SESSION_SECRET with: openssl rand -hex 32

POSTGRES_USER=simu
POSTGRES_PASSWORD=change_me_dev
POSTGRES_DB=simu

MINIO_ROOT_USER=simuadmin
MINIO_ROOT_PASSWORD=change_me_dev_minio

SESSION_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# Optional: SMTP (Mailpit dev default)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=noreply@simu.local

# Optional: public URL for email links
PUBLIC_BASE_URL=http://localhost:3000

# Optional: OpenTelemetry trace exporter via gRPC (Jaeger, Tempo, etc.)
# OTLP_ENDPOINT=http://jaeger:4317

# Optional: rate limit overrides (defaults 10 rps, 30 burst per IP)
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=30
